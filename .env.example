# WhatsApp admin numbers in international format, comma separated, WITHOUT +
ADMIN_NUMBERS=919999999999

# UPI used for payment QR
UPI_ID=yourupi@bank
UPI_NAME=Your Business

# Optional port for a simple health endpoint
PORT=10000

# Keep true for local/Termux. Set false only if Chromium is already managed by your host.
PUPPETEER_NO_SANDBOX=true
